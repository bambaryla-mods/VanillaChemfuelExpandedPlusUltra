  <ThingDef ParentName="BuildingBase">
    <defName>VCEUE_ToxicWasteTank</defName>
    <label>toxic waste tank</label>
    <description>An industrial liquid storage tank meant for storing toxic waste delivered via toxic waste pipe network. It requires power. When unpowered and filled, will take damage and cause a toxic fallout on destruction. Tanks can be designated to be siphoned for usable toxic waste as needed. If damaged even lightly the escaping fumes will very swiftly create a gaseous toxic fireball, the size of the resulting explosion will depend on the amount stored within.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Production/ToxicWasteTank/ToxicWasteTank</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,4)</drawSize>
      <drawOffsetEast>(0,2,0.2)</drawOffsetEast>
      <drawOffsetWest>(0,2,0.2)</drawOffsetWest>
      <drawOffsetNorth>(0,2,0.2)</drawOffsetNorth>
      <drawOffsetSouth>(0,2,0.2)</drawOffsetSouth>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>2750</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(2,3)</size>
    <costList>
      <Steel>140</Steel>
    </costList>
    <building>
      <relatedBuildCommands>
        <li>VCEUE_ToxicWastePipe</li>
        <li>VCEUE_UndergroundToxicWastePipe</li>
        <li>VCEUE_ToxicWasteValve</li>
        <li>VCEUE_ToxicWasteTank</li>
        <li>VCEUE_ToxicWasteTap</li>
        <li>VCEUE_ToxicWasteDrain</li>
      </relatedBuildCommands>
    </building>
    <comps>
      <li Class="PipeSystem.CompProperties_ResourceStorage">
        <pipeNet>VCEUE_ToxicWasteNet</pipeNet>
        <storageCapacity>500</storageCapacity>
        <barSize>(1.3, 0.25)</barSize>
        <margin>0.1</margin>
        <centerOffset>(0, 0, 0.35)</centerOffset>
        <extractOptions>
          <texPath>UI/Gizmos/ExtractWastepack</texPath>
          <labelKey>VCEUE_ExtractWastepack</labelKey>
          <descKey>VCEUE_ExtractWastepackDesc</descKey>
          <extractAmount>150</extractAmount>
          <thing>Wastepack</thing>
          <ratio>1</ratio>
        </extractOptions>
      </li>
      <li Class="PipeSystem.CompProperties_ExplosiveContent">
        <explosiveMaxRadius>12</explosiveMaxRadius>
        <!-- Vanilla options below -->
        <explosiveDamageType>Flame</explosiveDamageType>
        <destroyThingOnExplosionSize>2</destroyThingOnExplosionSize>
        <startWickHitPointsPercent>0.333</startWickHitPointsPercent>
        <preExplosionSpawnThingDef>Filth_Fuel</preExplosionSpawnThingDef>
        <preExplosionSpawnChance>1</preExplosionSpawnChance>
        <wickTicks>70~150</wickTicks>
      </li>
      <li Class="VCEPlusUltra.CompProperties_DamageWhenUnpowered">
        <tickRateInterval>960</tickRateInterval>
        <damageAmount>25</damageAmount>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>250</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="VCEPlusUltra.CompProperties_CauseConditionWhenDestroyed">
        <condition>ToxicFallout</condition>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>VCHE_PipeNetworks</designationCategory>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <canOverlapZones>false</canOverlapZones>
    <researchPrerequisites>
      <li>VCEUE_Biotech_DyeRefining</li>
    </researchPrerequisites>
    <designatorDropdown>PipeContainers</designatorDropdown>
  </ThingDef>

