<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>VCEUE_AutoPlasteelRefinery</defName>
    <label>Auto Plasteel Refinery</label>
    <description>A complex machine capable of turning Deepchem directly into Plasteel at cost of power and efficiency.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Production/VCEUE_AutoPlasteeler/VCEUE_RawPlasteelRefinery</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(7.5,7.5)</drawSize>
      <drawOffset>(-0,2,0.175)</drawOffset>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <inspectorTabs>
      <li>PipeSystem.ITab_Processor</li>
    </inspectorTabs>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(5,5)</size>
    <costList>
      <Plasteel>200</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <comps>
      <li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
        <showBufferInfo>false</showBufferInfo>
        <notWorkingKey>VCEUE_CantRefinePlasteel</notWorkingKey>
        <progressBarOffset>(0, 0, -0.65)</progressBarOffset>
        <showResultItem>true</showResultItem>
        <processes>
          <li>VCEUE_RawPlasteelIV</li>
        </processes>
        <!-- <soundAmbient>VCHE_RefineryAmbient</soundAmbient> -->
      </li>
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>VCHE_DeepchemNet</pipeNet>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>10000</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>VCHE_PipeNetworks</designationCategory>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <canOverlapZones>false</canOverlapZones>
    <researchPrerequisites>
      <li>VCEUE_RawPlasteelRefiningIV</li>
    </researchPrerequisites>
    <designatorDropdown>Refineries</designatorDropdown>
    <building>
      <buildingSizeCategory>Medium</buildingSizeCategory>
      <relatedBuildCommands>
        <li>VCEUE_Autoclave</li>
        <li>VCEUE_AdvancedAutoWeavery</li>
        <li>PS_DeepchemRefinery</li>
        <li>VCHE_DeepchemPipe</li>
        <li>VCHE_UndergroundDeepchemPipe</li>
        <li>VCHE_DeepchemValve</li>
        <li>PS_DeepchemTank</li>
        <li>VCHE_DeepchemTap</li>
        <li>VCHE_DeepchemDrain</li>
      </relatedBuildCommands>
    </building>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>VCEUE_AutoWeaver</defName>
    <label>Advanced Automatic Thread Molder</label>
    <description>A complex machine capable of directly weaving a fiber of choice from liquid products.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Production/VCEUE_AutoThreader/VCEUE_ThreadMachine</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(8,8)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <rotatable>false</rotatable>
    <inspectorTabs>
      <li>PipeSystem.ITab_Processor</li>
    </inspectorTabs>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(6,6)</size>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
        <showBufferInfo>false</showBufferInfo>
        <notWorkingKey>VCEUE_CantRefinePlasteel</notWorkingKey>
        <progressBarOffset>(0, 0, -0.65)</progressBarOffset>
        <showResultItem>true</showResultItem>
        <processes>
          <li>VCEUE_RawDevilstrandIV</li>
          <li>VCEUE_RawSynthreadIV</li>
          <li>VCEUE_RawHyperweaveIV</li>
        </processes>
        <!-- <soundAmbient>VCHE_RefineryAmbient</soundAmbient> -->
      </li>
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>VCHE_DeepchemNet</pipeNet>
      </li>
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>VCHE_ChemfuelNet</pipeNet>
      </li>
      <li Class="PipeSystem.CompProperties_Resource">
        <pipeNet>VREA_NeutroamineNet</pipeNet>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>10000</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>VCHE_PipeNetworks</designationCategory>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <canOverlapZones>false</canOverlapZones>
    <researchPrerequisites>
      <li>VCEUE_SynthreadRefiningIII</li>
    </researchPrerequisites>
    <designatorDropdown>Refineries</designatorDropdown>
    <building>
      <buildingSizeCategory>Medium</buildingSizeCategory>
      <relatedBuildCommands>
        <li>VCEUE_Autoweave</li>
        <li>VCEUE_RawPlasteelRefinery</li>
        <li>PS_DeepchemRefinery</li>
        <li>VCHE_DeepchemPipe</li>
        <li>VCHE_UndergroundDeepchemPipe</li>
        <li>VCHE_DeepchemValve</li>
        <li>PS_DeepchemTank</li>
        <li>VCHE_DeepchemTap</li>
        <li>VCHE_DeepchemDrain</li>
      </relatedBuildCommands>
    </building>
  </ThingDef>

</Defs>