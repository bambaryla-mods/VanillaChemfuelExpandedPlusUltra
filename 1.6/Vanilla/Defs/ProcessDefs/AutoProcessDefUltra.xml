    <PipeSystem.ProcessDef>
        <defName>VCEUE_RawHyperweaveIV</defName>
        <label>Make most Hyperweave from Raw Thread quickest</label>
        <ingredients>
            <li>
                <pipeNet>VCHE_ChemfuelNet</pipeNet>
                <thing>Chemfuel</thing>
                <countNeeded>100</countNeeded>
            </li>
            <li>
                <pipeNet>VREA_NeutroamineNet</pipeNet>
                <thing>Neutroamine</thing>
                <countNeeded>100</countNeeded>
            </li>
        </ingredients>
        <results>
            <li>
                <thing>Hyperweave</thing>
                <count>175</count>
