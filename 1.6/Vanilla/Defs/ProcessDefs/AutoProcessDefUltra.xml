<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <PipeSystem.ProcessDef>
        <defName>VCEUE_RawPlasteelIV</defName>
        <label>Make Plasteel directly from Deepchem</label>
        <ingredients>
            <li>
                <pipeNet>VCHE_DeepchemNet</pipeNet>
                <thing>VCHE_Deepchem</thing>
                <countNeeded>500</countNeeded>
            </li>
        </ingredients>
        <results>
            <li>
                <thing>Plasteel</thing>
                <count>250</count>
            </li>
        </results>
        <ticks>75000</ticks>
        <destroyIngredientsDirectly>true</destroyIngredientsDirectly>
        <researchPrerequisites>
            <li>VCEUE_RawPlasteelRefiningIV</li>
        </researchPrerequisites>
    </PipeSystem.ProcessDef>

