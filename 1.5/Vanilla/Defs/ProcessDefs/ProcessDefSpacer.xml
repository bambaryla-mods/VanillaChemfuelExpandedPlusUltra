<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <!-- Chemfuel Network -->
    <PipeSystem.ProcessDef>
        <defName>VCEUE_DeepchemIntoChemfuelTierII</defName>
        <label>Make Chemfuel from Deepchem faster.</label>
        <ingredients>
            <li>
                <pipeNet>VCHE_DeepchemNet</pipeNet>
                <thing>VCHE_Deepchem</thing>
                <countNeeded>3</countNeeded>
            </li>
        </ingredients>
        <ticks>200</ticks>
        <results>
            <li>
                <pipeNet>VCHE_ChemfuelNet</pipeNet>
                <thing>Chemfuel</thing>
                <count>9</count>
            </li>
        </results>
        <destroyIngredientsDirectly>true</destroyIngredientsDirectly>
        <researchPrerequisites>
            <li>VCEUE_ChemfuelRefiningTierII</li>
        </researchPrerequisites>
    </PipeSystem.ProcessDef>

    <!-- Dye Network -->
    <PipeSystem.ProcessDef>
        <defName>VCEUE_ChemfuelIntoDyeTierII</defName>
        <label>Make Dye from Chemfuel faster.</label>
        <ingredients>
            <li>
                <pipeNet>VCHE_ChemfuelNet</pipeNet>
                <thing>Chemfuel</thing>
                <countNeeded>7</countNeeded>
            </li>
            <li>
                <pipeNet>VREA_NeutroamineNet</pipeNet>
                <thing>Neutroamine</thing>
                <countNeeded>3</countNeeded>
            </li>
        </ingredients>
        <ticks>6000</ticks>
        <results>
            <li>
                <pipeNet>VCEUE_DyeNet</pipeNet>
                <thing>Dye</thing>
                <count>20</count>
            </li>
        </results>
        <destroyIngredientsDirectly>true</destroyIngredientsDirectly>
        <researchPrerequisites>
            <li>VCEUE_DyeRefiningTierII</li>
        </researchPrerequisites>
    </PipeSystem.ProcessDef>

    <!-- Neutroamine Network -->
    <PipeSystem.ProcessDef>
        <defName>VCEUE_DeepchemIntoNeutroamineTierII</defName>
        <label>Make Neutroamine from Deepchem faster.</label>
        <ingredients>
            <li>
                <pipeNet>VCHE_DeepchemNet</pipeNet>
                <thing>VCHE_Deepchem</thing>
                <countNeeded>10</countNeeded>
            </li>
        </ingredients>
        <ticks>8000</ticks>
        <results>
            <li>
                <pipeNet>VREA_NeutroamineNet</pipeNet>
                <thing>Neutroamine</thing>
                <count>3</count>
            </li>
        </results>
        <destroyIngredientsDirectly>true</destroyIngredientsDirectly>
        <researchPrerequisites>
            <li>VCEUE_NeutroamineRefiningTierII</li>
        </researchPrerequisites>
    </PipeSystem.ProcessDef>
</Defs>