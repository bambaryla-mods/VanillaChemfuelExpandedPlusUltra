<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <!-- Chemfuel Network -->
    <PipeSystem.ProcessDef>
        <defName>VCEUE_DeepchemIntoChemfuelTierIII</defName>
        <label>Make Chemfuel from Deepchem the fastest way.</label>
        <ingredients>
            <li>
                <pipeNet>VCHE_DeepchemNet</pipeNet>
                <thing>VCHE_Deepchem</thing>
                <countNeeded>3</countNeeded>
            </li>
        </ingredients>
        <ticks>100</ticks>
        <results>
            <li>
                <pipeNet>VCHE_ChemfuelNet</pipeNet>
                <thing>Chemfuel</thing>
                <count>9</count>
            </li>
        </results>
        <destroyIngredientsDirectly>true</destroyIngredientsDirectly>
        <researchPrerequisites>
            <li>VCEUE_ChemfuelRefiningTierIII</li>
        </researchPrerequisites>
    </PipeSystem.ProcessDef>

    <!-- Dye Network -->
    <PipeSystem.ProcessDef>
        <defName>VCEUE_ChemfuelIntoDyeTierIII</defName>
        <label>Make Dye from Chemfuel the fastest way</label>
        <ingredients>
            <li>
                <pipeNet>VCHE_ChemfuelNet</pipeNet>
                <thing>Chemfuel</thing>
                <countNeeded>7</countNeeded>
            </li>
            <li>
                <pipeNet>VREA_NeutroamineNet</pipeNet>
                <thing>Neutroamine</thing>
                <countNeeded>3</countNeeded>
            </li>
        </ingredients>
        <ticks>4000</ticks>
        <results>
            <li>
                <pipeNet>VCEUE_DyeNet</pipeNet>
                <thing>Dye</thing>
                <count>20</count>
            </li>
        </results>
        <destroyIngredientsDirectly>true</destroyIngredientsDirectly>
        <researchPrerequisites>
            <li>VCEUE_DyeRefiningTierIII</li>
        </researchPrerequisites>
    </PipeSystem.ProcessDef>

    <!-- Neutroamine Network -->
    <PipeSystem.ProcessDef>
        <defName>VCEUE_DeepchemIntoNeutroamineTierIII</defName>
        <label>Make Neutroamine from Deepchem the fastest way</label>
        <ingredients>
            <li>
                <pipeNet>VCHE_DeepchemNet</pipeNet>
                <thing>VCHE_Deepchem</thing>
                <countNeeded>10</countNeeded>
            </li>
        </ingredients>
        <ticks>6000</ticks>
        <results>
            <li>
                <pipeNet>VREA_NeutroamineNet</pipeNet>
                <thing>Neutroamine</thing>
                <count>3</count>
            </li>
        </results>
        <destroyIngredientsDirectly>true</destroyIngredientsDirectly>
        <researchPrerequisites>
            <li>VCEUE_NeutroamineRefiningTierIII</li>
        </researchPrerequisites>
    </PipeSystem.ProcessDef>
</Defs>