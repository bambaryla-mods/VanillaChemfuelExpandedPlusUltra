<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>VCEPU_RawPlasteelRefinery</defName>
    <label>Raw Plasteel Refinery</label>
    <description>A complex machine capable of refining raw plasteel from deepchem delivered via deepchem pipes into usable plasteel components. If no output is detected, the plasteel components will automatically be dispensed into cans. If the output is connected to a tank or tap via plasteel pipes, the finished product will be transported as such for storage or dispensing.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Production/VCEPU_RawPlasteelRefinery</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(3,3)</size>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="PipeSystem.CompProperties_ResourceProcessor">
        <pipeNet>VCHE_DeepchemNet</pipeNet>
        <showBufferInfo>false</showBufferInfo>
        <results>
          <li>
            <countNeeded>50</countNeeded>
            <eachTicks>12000</eachTicks>
            <thing>VCEPU_RawPlasteel</thing>
            <thingCount>5</thingCount>
          </li>
        </results>
        <soundAmbient>VCHE_RefineryAmbient</soundAmbient>
        <notWorkingKey>VCEPU_CantRefine</notWorkingKey>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>5000</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>VCHE_PipeNetworks</designationCategory>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <canOverlapZones>false</canOverlapZones>
    <researchPrerequisites>
      <li>VCEPU_RawPlasteelRefining</li>
    </researchPrerequisites>
    <designatorDropdown>Refineries</designatorDropdown>
    <building>
        <buildingSizeCategory>Medium</buildingSizeCategory>
        <relatedBuildCommands>
            <li>VCEPU_Autoclave</li>
            <li>VCEPU_AdvancedAutoWeavery</li>
            <li>PS_DeepchemRefinery</li>
            <li>VCHE_DeepchemPipe</li>
            <li>VCHE_UndergroundDeepchemPipe</li>
            <li>VCHE_DeepchemValve</li>
            <li>PS_DeepchemTank</li>
            <li>VCHE_DeepchemTap</li>
            <li>PS_DeepchemRefinery</li>
            <li>VCHE_DeepchemDrain</li>
        </relatedBuildCommands>
    </building>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>VCEPU_AdvancedAutoWeavery</defName>
    <label>Advanced Automatic Weavery</label>
    <description>A complex machine capable of automatically weaving a very plastic precursor to fibers. If no output is detected, the finished products will automatically be dispensed into cans. If the output is connected to a storage or dispensing device via textile pipes, the finished products will be transported as such for storage or dispensing.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Production/VCEPU_ThreadMachine</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(3,3)</size>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="PipeSystem.CompProperties_ResourceProcessor">
        <pipeNet>VCHE_DeepchemNet</pipeNet>
        <showBufferInfo>false</showBufferInfo>
        <results>
          <li>
            <countNeeded>50</countNeeded>
            <eachTicks>16000</eachTicks>
            <thing>VCEPU_RawThread</thing>
            <thingCount>30</thingCount>
          </li>
        </results>
        <soundAmbient>VCHE_RefineryAmbient</soundAmbient>
        <notWorkingKey>VCEPU_CantRefine</notWorkingKey>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>3000</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>VCHE_PipeNetworks</designationCategory>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <constructEffect>ConstructMetal</constructEffect>
    <canOverlapZones>false</canOverlapZones>
    <researchPrerequisites>
      <li>VCEPU_SynthreadRefining</li>
    </researchPrerequisites>
    <designatorDropdown>Refineries</designatorDropdown>
    <building>
        <buildingSizeCategory>Medium</buildingSizeCategory>
        <relatedBuildCommands>
            <li>VCEPU_Autoweave</li>
            <li>VCEPU_RawPlasteelRefinery</li>
            <li>PS_DeepchemRefinery</li>
            <li>VCHE_DeepchemPipe</li>
            <li>VCHE_UndergroundDeepchemPipe</li>
            <li>VCHE_DeepchemValve</li>
            <li>PS_DeepchemTank</li>
            <li>VCHE_DeepchemTap</li>
            <li>PS_DeepchemRefinery</li>
            <li>VCHE_DeepchemDrain</li>
        </relatedBuildCommands>
    </building>
  </ThingDef>

</Defs>